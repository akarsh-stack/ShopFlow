# Copy this into Railway variables or use as reference when setting variables via CLI.

# Databases (Railway may provide these; if so, replace these values with Railway-provided URLs)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=strong-password
POSTGRES_DB=shopflow
DATABASE_URL=postgresql://postgres:strong-password@<postgres-host>:5432/shopflow

MONGO_URL=mongodb://admin:strong-password@<mongo-host>:27017/shopflow?authSource=admin

# Service URLs (Railway will give these after deploy)
NEXT_PUBLIC_PRODUCT_SERVICE_URL=https://<product-service-url>
NEXT_PUBLIC_ORDER_SERVICE_URL=https://<order-service-url>
NEXT_PUBLIC_AUTH_SERVICE_URL=https://<auth-service-url>
NEXT_PUBLIC_PAYMENT_SERVICE_URL=https://<payment-service-url>

# Third party keys
CLERK_SECRET_KEY=your-clerk-secret
STRIPE_SECRET_KEY=your-stripe-secret
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REFRESH_TOKEN=your-google-refresh-token

# Kafka (use Upstash/Confluent) — set a comma-separated list of brokers
KAFKA_BROKERS=broker1:port,broker2:port
