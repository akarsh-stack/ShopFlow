# Copy this file to .env on your DigitalOcean droplet and replace the placeholder values.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=shopflow

MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=change-this-password

CLIENT_ORIGIN=http://YOUR_SERVER_IP:3002
ADMIN_ORIGIN=http://YOUR_SERVER_IP:3003

NEXT_PUBLIC_PRODUCT_SERVICE_URL=http://YOUR_SERVER_IP:8000
NEXT_PUBLIC_ORDER_SERVICE_URL=http://YOUR_SERVER_IP:8001
NEXT_PUBLIC_AUTH_SERVICE_URL=http://YOUR_SERVER_IP:8003
NEXT_PUBLIC_PAYMENT_SERVICE_URL=http://YOUR_SERVER_IP:8002
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name

DATABASE_URL=postgresql://postgres:change-this-password@postgres:5432/shopflow
MONGO_URL=mongodb://admin:change-this-password@mongo:27017/shopflow?authSource=admin

CLERK_SECRET_KEY=your-clerk-secret-key
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REFRESH_TOKEN=your-google-refresh-token
